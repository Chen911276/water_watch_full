# 水見設定檔範例
# 用法：把這個檔案「複製一份」改名為 settings.env，再填入下面的值。
# 不填也能跑：只會有 Discord 通知（Discord 不需要任何金鑰）。
# ⚠️ settings.env 裡有金鑰，不要上傳到 GitHub 或傳給別人。

# ---------- Telegram（選用） ----------
# 跟 @BotFather 說 /newbot 建立 Bot，拿到的 token 貼在這裡
TELEGRAM_BOT_TOKEN=

# ---------- LINE（選用） ----------
# 到 LINE Developers 建立 Messaging API channel 後取得
LINE_CHANNEL_ACCESS_TOKEN=
LINE_CHANNEL_SECRET=

# ---------- 其他（通常不用改） ----------
# PORT=8000
# FETCH_INTERVAL_MINUTES=60
# 算不出蓄水率的水庫預設不顯示；改成 0 就全部顯示
# HIDE_NO_RATE=1
